-- Logo Sürükleme Mantığı
local draggingLogo = false
local logoDragStart, logoStartPos
local isDragged = false

logo.MouseButton1Down:Connect(function()
    draggingLogo = true
    isDragged = false
    logoDragStart = UIS:GetMouseLocation()
    logoStartPos = logo.Position
end)

UIS.InputChanged:Connect(function(input)
    if draggingLogo and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local currentPos = UIS:GetMouseLocation()
        local delta = currentPos - logoDragStart
        
        if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
            isDragged = true
        end
        
        logo.Position = UDim2.new(logoStartPos.X.Scale, logoStartPos.X.Offset + delta.X, logoStartPos.Y.Scale, logoStartPos.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if draggingLogo then
            draggingLogo = false
            if not isDragged then
                logo.Visible = false
                main.Visible = true
            end
        end
    end
end)

