end)

local espObjects = {}
local function createESP(target)
    if target == player or not target.Character then return end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "YtESP"
    box.Size = Vector3.new(4, 6, 4)
    box.Adornee = target.Character:WaitForChild("HumanoidRootPart", 5)
    if not box.Adornee then box:Destroy() return end
    box.Color3 = Color3.fromRGB(255, 0, 0)
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Parent = target.Character.HumanoidRootPart
    
    espObjects[target] = box
end

espBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espBtn.Text = "ESP: " .. (espEnabled and "AÇIK" or "KAPALI")
    espBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(60, 60, 75)
    
    if espEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player then
                createESP(p)
                p.CharacterAdded:Connect(function() createESP(p) end)
            end
        end
    else
        for p, obj in pairs(espObjects) do
            obj:Destroy()
        end
        espObjects = {}
    end
end)

tpBtn.MouseButton1Click:Connect(function()
    local mouse = player:GetMouse()
    local target = mouse.Hit
    if target and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = CFrame.new(target.X, target.Y + 3, target.Z)
    end
end)

fullbrightBtn.MouseButton1Click:Connect(function()
    fullbrightEnabled = not fullbrightEnabled
    fullbrightBtn.Text = "Fullbright: " .. (fullbrightEnabled and "AÇIK" or "KAPALI")
    fullbrightBtn.BackgroundColor3 = fullbrightEnabled and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(60, 60, 75)
    
    if fullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    else
        Lighting.Ambient = Color3.fromRGB(70, 70, 70)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.Brightness = 1
    end
end)

player.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    task.wait(0.5)
    if char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = speedValue
        char.Humanoid.JumpPower = jumpValue
    end
end)
